{
  "name": "bogofy",
  "version": "2.0.0",
  "description": "WooCommerce Buy One Get One (BOGO) discount plugin",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.cart.config.js",
    "build:cart": "vite build --config vite.cart.config.js",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint frontend/src --ext .js,.jsx",
    "lint:fix": "eslint frontend/src --ext .js,.jsx --fix",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tanstack/react-query": "^5.24.0",
    "zustand": "^4.5.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.1.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.5.0",
    "msw": "^2.2.0",
    "prop-types": "^15.8.1"
  }
}
