# Files and directories that should NOT ship in the distributed plugin zip.
# (vendor/ is intentionally NOT listed — it is required at runtime.)

# Version control / CI
/.git
/.github
/.gitignore
/.distignore

# Editor / assistant / local tooling
/.claude
/.idea
/.vscode
claude-code-prompt-*.md

# WordPress.org page assets (icon/banner/screenshots) - not part of the plugin
/.wporg-assets

# Node / JS build toolchain (source in /frontend/src is kept for review)
/node_modules
/frontend/node_modules
package.json
package-lock.json
jest.config.js
postcss.config.js
tailwind.config.js
vite.config.js
.eslintrc.js

# PHP dev tooling
# composer.json is intentionally shipped (WordPress.org guideline: include it for open-source review).
composer.lock
phpunit.xml
.phpcs.xml
.phpunit.result.cache
/tests
/bin

# Docs / misc
/docs

# Git placeholder files
.gitkeep

# Build artifacts
*.zip

# Logs and OS files
*.log
.DS_Store
Thumbs.db
