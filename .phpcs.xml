<?xml version="1.0"?>
<ruleset name="Buy One Get One Coding Standards">
    <description>PHP Coding Standards for Buy One Get One plugin.</description>

    <!-- What to scan -->
    <file>./inc</file>
    <file>./bogofy.php</file>
    <file>./uninstall.php</file>

    <!-- Exclude paths -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./assets/*</exclude-pattern>
    <exclude-pattern>./tests/*</exclude-pattern>

    <!-- Show progress and sniff codes in all reports -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="bogofy"/>
            </property>
        </properties>
    </rule>

    <!-- Custom capabilities provided by WooCommerce. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!--
        The data-access layer talks to the plugin's own custom table, so direct
        $wpdb calls (and the schema create/drop in setup/teardown) are expected
        and unavoidable. Object caching is handled in the hot read path
        (RuleRepository::get_active_rules). Scope the sniff off for these files
        only, rather than sprinkling per-line ignores.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/inc/Models/RuleRepository.php</exclude-pattern>
        <exclude-pattern>*/inc/Database/Schema.php</exclude-pattern>
        <exclude-pattern>*/uninstall.php</exclude-pattern>
    </rule>

    <!-- Show warnings in reports, but do not fail the build (exit 0) on warnings only. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Minimum PHP and WP versions -->
    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>
</ruleset>
