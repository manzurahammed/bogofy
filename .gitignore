# Lock files are committed for reproducible CI builds
# (npm ci and composer install require them, and setup-node caches on them).

# Claude Code (ignore local state, but share project skills)
/.claude/*
!/.claude/skills/

# Development spec files
claude-code-prompt-*.md

# WordPress uploads during testing
/uploads/

# Temporary files
/tmp/
*.tmp
*.temp

# Debug files
debug.log
error_log
